  "description": "Procedural chiptune UI sound effects for gamifiedUI. Web Audio only: no audio files, no dependencies.",
  "license": "Apache-2.0",
  "funding": "https://github.com/sponsors/carsonhung",
  "author": "Carson Hung (https://github.com/carsonhung)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/gamifiedUI.git",
    "directory": "packages/gamifiedui-sfx"
  },
  "keywords": [
    "game-ui",
    "sound-effects",
    "sfx",
    "web-audio",
    "chiptune",
    "8bit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
