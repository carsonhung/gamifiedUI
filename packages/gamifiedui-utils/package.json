{
  "name": "gamifiedui-utils",
  "version": "0.1.0",
  "description": "Optional, dependency-free JS helpers for gamifiedUI: toasts, typewriter, counters, cooldowns, floating text, particle bursts, tabs.",
  "license": "Apache-2.0",
  "author": "Carson Hung (https://github.com/carsonhung)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/gamifiedUI.git",
    "directory": "packages/gamifiedui-utils"
  },
  "keywords": ["game-ui", "toast", "typewriter", "particles", "tailwindcss"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
